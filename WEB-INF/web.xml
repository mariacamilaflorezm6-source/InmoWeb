<?xml version="1.0" encoding="UTF-8"?>
<!--
    web.xml - Descriptor de despliegue de InmoWeb.
    Version 4.0 = Java EE 8 (Tomcat 9, y funciona igual en 8.5).
    Para Tomcat 10 u 11, cambie el espacio de nombres a jakarta
    (mismo ajuste que se explico en el proyecto de la heladeria).
-->
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee
             http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd"
         version="4.0">

    <display-name>InmoWeb</display-name>

    <welcome-file-list>
        <welcome-file>index.jsp</welcome-file>
    </welcome-file-list>

    <session-config>
        <session-timeout>30</session-timeout>
    </session-config>

    <jsp-config>
        <jsp-property-group>
            <url-pattern>*.jsp</url-pattern>
            <page-encoding>UTF-8</page-encoding>
            <trim-directive-whitespaces>true</trim-directive-whitespaces>
        </jsp-property-group>
    </jsp-config>

    <!--
        Habilita la subida de archivos (multipart/form-data) para TODAS las
        paginas JSP, redeclarando el servlet interno "jsp" que ya trae Tomcat
        (org.apache.jasper.servlet.JspServlet) solo para agregarle
        <multipart-config>. No hace falta ninguna libreria externa: se usa
        la API nativa de Servlet 3.0+ (request.getPart / request.getParts)
        directamente en los .jsp que reciben el formulario de documentos.
    -->
    <servlet>
        <servlet-name>jsp</servlet-name>
        <multipart-config>
            <max-file-size>10485760</max-file-size>       <!-- 10 MB por archivo -->
            <max-request-size>31457280</max-request-size> <!-- 30 MB por peticion -->
            <file-size-threshold>1048576</file-size-threshold>
        </multipart-config>
    </servlet>

    <error-page>
        <error-code>404</error-code>
        <location>/index.jsp</location>
    </error-page>

    <!--
        Filtro de control de acceso por rol (obligatorio segun el enunciado
        del parcial). Intercepta TODA peticion (url-pattern /*) y decide,
        segun el prefijo de la URL, si exige sesion y que rol especifico.
        Codigo fuente en: WEB-INF/src/com/inmoweb/filtro/ControlAccesoFilter.java
        Clase compilada en: WEB-INF/classes/com/inmoweb/filtro/ControlAccesoFilter.class
    -->
    <filter>
        <filter-name>ControlAccesoFilter</filter-name>
        <filter-class>com.inmoweb.filtro.ControlAccesoFilter</filter-class>
    </filter>
    <filter-mapping>
        <filter-name>ControlAccesoFilter</filter-name>
        <url-pattern>/*</url-pattern>
    </filter-mapping>
</web-app>
