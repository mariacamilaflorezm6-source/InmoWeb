<%-- pie.jspf - Cierre de la pagina y carga del JavaScript de Bootstrap. --%>
<%@ page pageEncoding="UTF-8" %>
</main>
<footer class="footer-inmoweb bg-dark text-light pt-5 pb-4 mt-5">
  <div class="container">
    <div class="row g-4">
      <div class="col-md-4">
        <h5 class="fw-bold mb-2"><i class="bi bi-buildings"></i> InmoWeb</h5>
        <p class="small text-light-emphasis mb-0">
            Te ayudamos a encontrar, comprar y arrendar la propiedad ideal en
            Santander, con un acompañamiento cercano en todo el proceso.</p>
      </div>
      <div class="col-md-4">
        <h6 class="fw-bold mb-2">Enlaces</h6>
        <ul class="list-unstyled small mb-0">
          <li class="mb-1"><a class="footer-link" href="<%= request.getContextPath() %>/index.jsp#inicio">Inicio</a></li>
          <li class="mb-1"><a class="footer-link" href="<%= request.getContextPath() %>/propiedades/catalogo.jsp">Propiedades</a></li>
          <li class="mb-1"><a class="footer-link" href="<%= request.getContextPath() %>/index.jsp#sobre-nosotros">Sobre nosotros</a></li>
          <li class="mb-1"><a class="footer-link" href="<%= request.getContextPath() %>/index.jsp#contacto">Contacto</a></li>
        </ul>
      </div>
      <div class="col-md-4">
        <h6 class="fw-bold mb-2">Contacto</h6>
        <ul class="list-unstyled small mb-0 text-light-emphasis">
          <li class="mb-1"><i class="bi bi-geo-alt"></i> Bucaramanga, Santander</li>
          <li class="mb-1"><i class="bi bi-telephone"></i> (607) 000 0000</li>
          <li class="mb-1"><i class="bi bi-envelope"></i> contacto@inmoweb.com</li>
        </ul>
      </div>
    </div>
    <hr class="border-secondary my-4">
    <p class="text-center small text-light-emphasis mb-0">
        &copy; 2026 InmoWeb &middot; Sistema de gestión inmobiliaria &middot; Programación Web Java &middot; UTS</p>
  </div>
</footer>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
