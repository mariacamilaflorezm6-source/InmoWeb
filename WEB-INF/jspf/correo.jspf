<%--
    correo.jspf - Envio de correos electronicos via SMTP (Gmail).
    Se incluye de forma ESTATICA donde se necesite enviar un correo:
        <%@ include file="/WEB-INF/jspf/correo.jspf" %>

    CONFIGURACION NECESARIA (una sola vez):
    1) Active la verificacion en 2 pasos en la cuenta de Gmail que va a usar
       para ENVIAR los correos: https://myaccount.google.com/security
    2) Genere una "contrasena de aplicacion" (16 caracteres) en:
       https://myaccount.google.com/apppasswords
       NUNCA use la contrasena normal de la cuenta de Gmail: Google la rechaza
       para este tipo de conexion y ademas es un riesgo de seguridad innecesario.
    3) Reemplace SMTP_USUARIO y SMTP_CLAVE mas abajo con ese correo y esa
       contrasena de aplicacion (no la contrasena normal).
--%>
<%@ page import="java.util.Properties" %>
<%@ page import="javax.mail.*" %>
<%@ page import="javax.mail.internet.*" %>
<%@ page pageEncoding="UTF-8" %>
<%!
    // ====== CONFIGURACION DE CORREO (cambiar aqui, en un solo lugar) ======
    private static final String SMTP_HOST = "smtp.gmail.com";
    private static final int    SMTP_PUERTO = 587;
    private static final String SMTP_USUARIO = "mariacamilaflorez2004@gmail.com";
    private static final String SMTP_CLAVE = "ybzumaklvobwfiuo";
    private static final String SMTP_NOMBRE_REMITENTE = "InmoWeb - Seguridad";

    /**
     * Envia un correo HTML sencillo. Lanza MessagingException si algo falla
     * (SMTP mal configurado, sin internet, credenciales invalidas, etc.);
     * quien la llama decide si eso debe interrumpir su flujo o no.
     */
    public void enviarCorreo(String destino, String asunto, String cuerpoHtml) throws MessagingException {
        Properties props = new Properties();
        props.put("mail.smtp.auth", "true");
        props.put("mail.smtp.starttls.enable", "true");
        props.put("mail.smtp.host", SMTP_HOST);
        props.put("mail.smtp.port", String.valueOf(SMTP_PUERTO));
        // Da hasta 8 segundos antes de fallar, para no dejar la pagina
        // de login "congelada" si el servidor SMTP no responde.
        props.put("mail.smtp.connectiontimeout", "8000");
        props.put("mail.smtp.timeout", "8000");

        Session session = Session.getInstance(props, new Authenticator() {
            protected PasswordAuthentication getPasswordAuthentication() {
                return new PasswordAuthentication(SMTP_USUARIO, SMTP_CLAVE);
            }
        });

        try {
            Message mensaje = new MimeMessage(session);
            mensaje.setFrom(new InternetAddress(SMTP_USUARIO, SMTP_NOMBRE_REMITENTE));
            mensaje.setRecipients(Message.RecipientType.TO, InternetAddress.parse(destino));
            mensaje.setSubject(asunto);
            mensaje.setContent(cuerpoHtml, "text/html; charset=UTF-8");
            Transport.send(mensaje);
        } catch (java.io.UnsupportedEncodingException ex) {
            throw new MessagingException("Nombre de remitente con codificacion invalida", ex);
        }
    }
%>
